[Unit]
Description=Switch Apple iBridge to USB config 2 for appletbdrm DRM
DefaultDependencies=no
After=systemd-udevd.service
Before=tiny-dfr.service display-manager.service graphical.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sleep 2
ExecStart=/bin/sh -c "\
  modprobe -r appletbdrm 2>/dev/null || true; \
  echo 2 > /sys/bus/usb/devices/1-3/bConfigurationValue; \
  modprobe appletbdrm; \
"
ExecStartPost=/bin/sleep 3

[Install]
WantedBy=sysinit.target
