[Unit]
Description=Tiny Apple Touch Bar Daemon
DefaultDependencies=no
After=systemd-udevd.service macbook-quirks.service
Before=display-manager.service graphical.target gdm.service
Wants=systemd-udevd.service macbook-quirks.service

[Service]
Type=simple
ExecStart=/usr/bin/tiny-dfr
Restart=always
RestartSec=3
# No burst limit: after suspend/resume the DRM device can take several seconds
# to register; without this systemd gives up after 5 failures in 10s.
StartLimitIntervalSec=0

[Install]
WantedBy=sysinit.target
